%% Elvis configuration.
%%
%% The rulesets below are elvis' defaults. The `rules' overrides that follow
%% each one are deliberate: every entry is a rule this code base breaks on
%% purpose, and the comment says why. Anything not listed is enforced as
%% shipped -- if a new violation appears, fix the code, not this file.

[
    {config, [
        #{
          files => ["src/*.erl"],
          ruleset => erl_files,
          rules => [
            % `=' is dropped from `operator_spaces': record and record-update syntax is
            % written tight throughout (`#dbus_header{fields=Fields, size=Pos}'),
            % as it is in OTP itself. Every other operator keeps its default.
            {elvis_style, operator_spaces, #{rules => [
              {right, "++"}, {left, "++"},
              {right, "+"}, {left, "+"},
              {right, "-"}, {left, "-"},
              {right, "*"}, {left, "*"},
              {right, "/"}, {left, "/"},
              {right, "=<"}, {left, "=<"},
              {right, "<"}, {left, "<"},
              {right, ">"}, {left, ">"},
              {right, ">="}, {left, ">="},
              {right, "=="}, {left, "=="},
              {right, "=:="}, {left, "=:="},
              {right, "/="}, {left, "/="},
              {right, "=/="}, {left, "=/="},
              {right, "--"}, {left, "--"},
              {right, "=>"}, {left, "=>"},
              {right, ":="}, {left, ":="},
              {right, "<-"}, {left, "<-"},
              {right, "<="}, {left, "<="},
              {right, "||"}, {left, "||"},
              {right, "|"}, {left, "|"},
              {right, "::"}, {left, "::"},
              {right, "->"}, {left, "->"},
              {right, ","},
              {right, "!"}, {left, "!"},
              {right, "?="}, {left, "?="},
              {right, ";"},
              {right, "<:="}, {left, "<:="},
              {right, "<:-"}, {left, "<:-"},
              {right, "&&"}, {left, "&&"}
            ]}},

            % Include guards (`?dbus_hrl') and the log macros (`?debug',
            % `?info', `?warn', `?error') are lowercase by convention and are
            % used by every module. Widen the regex rather than disable the
            % rule, so genuine constants are still checked.
            {elvis_style, macro_naming_convention, 
              #{regex => "^([A-Z](_?[A-Z0-9]+)*|[a-z](_?[a-z0-9]+)*)$"}},

            % 100 leaves no room for the aligned `#dbus_iface{}' literals in
            % the headers or for the record-heavy clause heads in the parser.
            {elvis_text_style, max_line_length, #{limit => 120}},

            %% `throw/1' is the wire codec's error channel, not an accident:
            %% `dbus_marshaller' and `dbus_introspect' throw on malformed
            %% input, `dbus_message:set_body/4' and `dbus_peer_connection'
            %% catch it and turn it into a D-Bus error reply, and the eunit
            %% suite asserts the thrown terms (`?_assertThrow'). `error/1'
            %% would bury those terms in a stack trace instead of leaving
            %% them a value callers match on.
            {elvis_style, no_throw, disable},

            %% The transports and the auth mechanisms block in `receive' by
            %% design: they are driven by socket data, and an `after' clause
            %% would turn a quiet peer into a spurious failure.
            {elvis_style, no_receive_without_timeout, disable},

            %% `dbus_peer_connection' dispatches to the transport and
            %% auth-mechanism module chosen from the server address at run
            %% time. The call is dynamic because the module is.
            {elvis_style, no_invalid_dynamic_calls, disable},

            %% The types are defined once in `include/dbus.hrl' and shared
            %% (see the `no_types' note below), so no single module can export
            %% them without publishing a duplicate of a type that already has
            %% one home.
            {elvis_style, export_used_types, disable},

            %% The duplication elvis finds is record-shaped: sibling clauses
            %% that build `#dbus_method{}' / `#dbus_signal{}' /
            %% `#dbus_property{}' from the same XML attributes read the same
            %% and are not factorable without losing the pattern match that
            %% selects them.
            {elvis_style, dont_repeat_yourself, disable}
          ]
         },
        #{
          files => ["include/*.hrl"],
          ruleset => hrl_files,
          rules => [
            % `=' is dropped from `operator_spaces': record and record-update syntax is
            % written tight throughout (`#dbus_header{fields=Fields, size=Pos}'),
            % as it is in OTP itself. Every other operator keeps its default.
            {elvis_style, operator_spaces, #{rules => [
              {right, "++"}, {left, "++"},
              {right, "+"}, {left, "+"},
              {right, "-"}, {left, "-"},
              {right, "*"}, {left, "*"},
              {right, "/"}, {left, "/"},
              {right, "=<"}, {left, "=<"},
              {right, "<"}, {left, "<"},
              {right, ">"}, {left, ">"},
              {right, ">="}, {left, ">="},
              {right, "=="}, {left, "=="},
              {right, "=:="}, {left, "=:="},
              {right, "/="}, {left, "/="},
              {right, "=/="}, {left, "=/="},
              {right, "--"}, {left, "--"},
              {right, "=>"}, {left, "=>"},
              {right, ":="}, {left, ":="},
              {right, "<-"}, {left, "<-"},
              {right, "<="}, {left, "<="},
              {right, "||"}, {left, "||"},
              {right, "|"}, {left, "|"},
              {right, "::"}, {left, "::"},
              {right, "->"}, {left, "->"},
              {right, ","},
              {right, "!"}, {left, "!"},
              {right, "?="}, {left, "?="},
              {right, ";"},
              {right, "<:="}, {left, "<:="},
              {right, "<:-"}, {left, "<:-"},
              {right, "&&"}, {left, "&&"}
            ]}},

            % Include guards (`?dbus_hrl') and the log macros (`?debug',
            % `?info', `?warn', `?error') are lowercase by convention and are
            % used by every module. Widen the regex rather than disable the
            % rule, so genuine constants are still checked.
            {elvis_style, macro_naming_convention, #{regex => "^([A-Z](_?[A-Z0-9]+)*|[a-z](_?[a-z0-9]+)*)$"}},

            % 100 leaves no room for the aligned `#dbus_iface{}' literals in
            % the headers or for the record-heavy clause heads in the parser.
            {elvis_text_style, max_line_length, #{limit => 120}},
            %% `include/dbus.hrl' is the published type contract of the
            %% library: `dbus_message()', `dbus_name()', `bus_id()' and
            %% friends are named in the specs of every exported function. They
            %% live in the header precisely so that users of the library get
            %% them from one `-include_lib'.
            {elvis_style, no_types, disable},

            %% The per-interface headers (`dbus_properties.hrl' and the rest)
            %% build `#dbus_iface{}' values, so they need the record
            %% definitions from `dbus.hrl'. Each is guarded against double
            %% inclusion.
            {elvis_style, no_includes, disable}
          ]
         },
        #{
          files => ["rebar.config"],
          ruleset => rebar_config
         }
    ]},
    % Possible values are 'plain', 'colors' or 'parsable' (default='colors').
    {output_format, colors},
    % verbose (optional): when 'true' more information will
    % be printed (default=false).
    {verbose, true},
    % no_output (optional): when 'true' nothing will be printed
    % (default=false).
    {no_output, false},
    % parallel: determine how many files will be
    % analyzed in parallel (default=1).
    {parallel, 1}
].
