%% Elvis configuration.
%%
%% The rulesets below are elvis' defaults. The `rules' overrides that follow
%% each one are deliberate: every entry is a rule this code base breaks on
%% purpose, and the comment says why. Anything not listed is enforced as
%% shipped -- if a new violation appears, fix the code, not this file.

[
    {config, [
        #{
          files => ["src/*.erl"],
          ruleset => erl_files,
          rules => []
         },
        #{
          files => ["include/*.hrl"],
          ruleset => hrl_files,
          rules => []
         },
        #{
          files => ["rebar.config"],
          ruleset => rebar_config
         }
    ]},
    % Possible values are 'plain', 'colors' or 'parsable' (default='colors').
    {output_format, colors},
    % verbose (optional): when 'true' more information will
    % be printed (default=false).
    {verbose, true},
    % no_output (optional): when 'true' nothing will be printed
    % (default=false).
    {no_output, false},
    % parallel: determine how many files will be
    % analyzed in parallel (default=1).
    {parallel, 1}
].
