%% rebar.config

{erl_opts, [
    debug_info,
    warning_as_error
]}.

%% Dialyzer
{dialyzer, [
    {plt_extra_apps, [
        crypto,
        xmerl
    ]}
]}.

%% Build/project plugins
{project_plugins, [
    rebar3_hex,
    rebar3_ex_doc,
    covertool,
    rebar3_lint
]}.

%% Enable coverage collection
{cover_enabled, true}.

%% covertool input
{covertool, [
    {coverdata_files, [
        "eunit.coverdata"
    ]}
]}.

{hex, [
    {doc, #{provider => ex_doc}}
]}.


%% EDoc / EEP-48 documentation chunks
{edoc_opts, [
    {doclet, edoc_doclet_chunks},
    {layout, edoc_layout_chunks},
    {preprocess, true}
]}.

%% ExDoc -> complete HTML site
{ex_doc, [
    {extras, [
        <<"README.md">>,
        <<"LICENSE">>
    ]},
    {main, <<"README.md">>},
    {source_url, <<"https://github.com/jeanparpaillon/erlang-dbus">>},
    {proglang, erlang}
]}.

{plugins, [
    rebar3_format
]}.