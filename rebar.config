%% rebar.config

{erl_opts, [
    debug_info,
    warning_as_error
]}.

%% Dialyzer
{dialyzer, [
    {plt_extra_apps, [
        crypto,
        xmerl
    ]}
]}.

%% Build/project plugins
{project_plugins, [
    rebar3_hex,
    rebar3_ex_doc,
    covertool,
    rebar3_lint
]}.

%% Enable coverage collection
{cover_enabled, true}.

%% covertool input
{covertool, [
    {coverdata_files, [
        "eunit.coverdata"
    ]}
]}.

{hex, [
    {doc, #{provider => ex_doc}}
]}.

%% EDoc / EEP-48 documentation chunks
{edoc_opts, [
    {doclet, edoc_doclet_chunks},
    {layout, edoc_layout_chunks},
    {preprocess, true}
]}.

%% ExDoc -> complete HTML site
{ex_doc, [
    {extras, [
        <<"README.md">>,
        <<"LICENSE">>
    ]},
    {main, <<"README.md">>},
    {source_url, <<"https://github.com/jeanparpaillon/erlang-dbus">>},
    {proglang, erlang}
]}.

%% Formatter
%%
%% erlfmt, not rebar3_format: erl_prettypr (which rebar3_format uses) has no
%% special case for OTP 27+ `-doc #{equiv => f(A, B)}`, whose parsed form holds
%% the expression AST as the map value. It prints that AST back out as a source
%% term, corrupting the attribute. erlfmt round-trips it, and preserves
%% triple-quoted doc strings instead of collapsing them to escaped one-liners.
{plugins, [
    erlfmt
]}.

{erlfmt, [
    write,
    {files, [
        "{src,include,test}/**/*.{hrl,erl,app.src}",
        "rebar.config"
    ]}
]}.
