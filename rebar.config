%% rebar.config

{erl_opts, [
    debug_info,
    warning_as_error
]}.

%% Dialyzer
{dialyzer, [
    {plt_extra_apps, [
        crypto,
        xmerl
    ]}
]}.

%% Build/project plugins
{project_plugins, [
    rebar3_hex,
    rebar3_ex_doc,
    covertool,
    rebar3_lint,
    rebar3_proper,
    erlfmt
]}.

%% PropEr is a test-only dependency. It is GPL-3.0 while this application is
%% Apache-2.0: it is never compiled into, nor distributed with, the released
%% artifact, which is why it lives in the `test' profile and nowhere else.
%%
%% `TEST' is defined explicitly because rebar3 only injects it for the `eunit'
%% and `ct' providers. Without it `rebar3 proper' would compile a different
%% `dbus_marshaller' than `rebar3 eunit' does -- one without the internal
%% functions the properties exercise.
{profiles, [
    {test, [
        {deps, [{proper, "1.5.0"}]},
        {erl_opts, [{d, 'TEST'}, {d, 'PROPER'}]}
    ]}
]}.

%% Enable coverage collection
{cover_enabled, true}.

%% covertool input
{covertool, [
    {coverdata_files, [
        "eunit.coverdata",
        "proper.coverdata"
    ]}
]}.

{hex, [
    {doc, #{provider => ex_doc}}
]}.

%% EDoc / EEP-48 documentation chunks
{edoc_opts, [
    {doclet, edoc_doclet_chunks},
    {layout, edoc_layout_chunks},
    {preprocess, true}
]}.

%% ExDoc -> complete HTML site
{ex_doc, [
    {extras, [
        <<"README.md">>,
        <<"LICENSE">>
    ]},
    {main, <<"README.md">>},
    {source_url, <<"https://github.com/jeanparpaillon/erlang-dbus">>},
    {proglang, erlang}
]}.

%% Formatter
{erlfmt, [
    write,
    {files, [
        "{src,include,test}/**/*.{hrl,erl,app.src}",
        "rebar.config"
    ]}
]}.
