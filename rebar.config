%% rebar.config

{erl_opts, [
    debug_info
]}.

%% EDoc / EEP-48 documentation chunks
{edoc_opts, [
    {doclet, edoc_doclet_chunks},
    {layout, edoc_layout_chunks},
    {preprocess, true}
]}.

%% Dialyzer
{dialyzer, [
    {plt_apps, [
        crypto,
        xmerl
    ]}
]}.

%% Build/project plugins
{project_plugins, [
    covertool
]}.

%% Enable coverage collection
{cover_enabled, true}.

%% covertool input
{covertool, [
    {coverdata_files, [
        "eunit.coverdata"
    ]}
]}.
